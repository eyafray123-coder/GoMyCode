Algorithm SumDistinct

Variables:
    A, B : arrays of integers
    n, m, i, j : integer
    sum : integer
    found : boolean

Begin
    Read n
    For i ← 0 to n-1 do
        Read A[i]
    EndFor

    Read m
    For i ← 0 to m-1 do
        Read B[i]
    EndFor

    sum ← 0

    
    For i ← 0 to n-1 do
        found ← False

        For j ← 0 to m-1 do
            If A[i] = B[j] Then
                found ← True
            EndIf
        EndFor

        If found = False Then
            sum ← sum + A[i]
        EndIf
    EndFor
    For i ← 0 to m-1 do
        found ← False

        For j ← 0 to n-1 do
            If B[i] = A[j] Then
                found ← True
            EndIf
        EndFor

        If found = False Then
            sum ← sum + B[i]
        EndIf
    EndFor

    Write "Sum = ", sum

End